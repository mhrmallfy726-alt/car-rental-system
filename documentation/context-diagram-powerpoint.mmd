flowchart LR
    classDef system fill:#123B5D,color:#FFFFFF,stroke:#0A2942,stroke-width:4px,font-size:22px,font-weight:bold;
    classDef user fill:#DDF4F0,color:#123B5D,stroke:#168A78,stroke-width:2px,font-size:15px;
    classDef service fill:#FFF0D9,color:#6B3D0B,stroke:#D99527,stroke-width:2px,font-size:14px;

    subgraph U[الجهات المستخدمة للنظام]
      direction TB
      C[العميل<br/>Customer]
      S[المورد / مالك المعرض<br/>Supplier]
      E[موظف المعرض<br/>Employee]
      A[مدير النظام<br/>Administrator]
    end

    R[نظام تأجير السيارات<br/>Car Rental System]

    subgraph X[الخدمات والأنظمة الخارجية]
      direction TB
      P[بوابة الدفع<br/>Payment Gateway]
      W[WhatsApp Cloud API]
      M[خدمة البريد الإلكتروني<br/>SMTP / Nodemailer]
      F[تخزين الصور والوثائق<br/>Cloud Storage]
    end

    C -->|التسجيل، البحث، الحجز، الدفع| R
    R -->|النتائج، التأكيد، الفاتورة، الإشعارات| C
    S -->|السيارات، الأسعار، المواقع، الحجوزات| R
    R -->|الطلبات، الأداء، المالية، التنبيهات| S
    E -->|مهام الاستلام والتسليم، الفحص، الصور| R
    R -->|الحجوزات، بيانات العميل والسيارة، المهام| E
    A -->|الاعتماد، الإدارة، الشكاوى، الصلاحيات| R
    R -->|المؤشرات، التقارير، سجل العمليات| A
    R -->|جلسات الدفع والتحصيل| P
    P -->|نتيجة الدفع وWebhooks| R
    R -->|OTP والتنبيهات ورسائل الحجز| W
    W -->|حالة الإرسال وWebhooks| R
    R -->|التحقق والإشعارات| M
    M -->|حالة التسليم| R
    R -->|صور السيارات والوثائق والتقارير| F
    F -->|روابط الملفات ونتيجة الرفع| R

    class R system
    class C,S,E,A user
    class P,W,M,F service
    style U fill:#F5FBFC,stroke:#9EC7C7,stroke-width:2px
    style X fill:#FFFBF2,stroke:#E7C27E,stroke-width:2px
    linkStyle default stroke:#78909C,stroke-width:1.6px
