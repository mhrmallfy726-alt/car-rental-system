# Local development server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL (create an empty database named car_rental_db first)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=car_rental_db
DB_USER=postgres
DB_PASSWORD=change_me_to_your_local_postgres_password

# Authentication (replace with a long random value before using real accounts)
JWT_SECRET=replace_with_a_long_random_local_secret
JWT_EXPIRES_IN=7d

# Optional external integrations. Keep empty for basic local development.
# In development, files are stored under backend/uploads when Supabase is not configured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Online card payments (not required for local browsing/testing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email delivery / OTP (account verification needs a configured email provider)
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Car Rental

# WhatsApp Cloud API (optional)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_DEFAULT_COUNTRY_CODE=967
WHATSAPP_REQUEST_TIMEOUT_MS=8000

# Optional location search integrations
GEOAPIFY_API_KEY=
